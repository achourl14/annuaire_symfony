{% extends 'base.html.twig' %}

{% block title %}Suppression du profil de l'utilisateur {{ utilisateur.login }} {% endblock %}

{% block body %}

    <div class="flex items-center justify-center min-h-screen bg-gray-100">
        <div class="bg-white p-6 rounded-lg shadow-md max-w-md w-full">
            <h2 class="text-2xl font-bold text-gray-800 mb-4">Supprimer le profil de l'utilisateur {{ utilisateur.login }}</h2>
            <p class="text-gray-600 mb-6">Êtes-vous sûr de vouloir supprimer définitivement votre compte ? Cette action est irréversible.</p>

            <div class="flex justify-end space-x-4">
                <button class="bg-red-500 hover:bg-green-600 text-green-800 font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline">
                    <a href="{{ path('app_home') }}"> Confirmer </a>
                </button>
                <button  class="bg-gray-300 hover:bg-red-400 text-red-800 font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline">
                    <a href="{{ path('app_home') }}"> Annuler</a>
                </button>

            </div>
        </div>
    </div>

{% endblock %}
