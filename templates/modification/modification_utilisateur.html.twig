{% extends 'base.html.twig' %}

{% block title %}Modification du profil de l'utilisateur{% endblock %}

{% block body %}
    <div class="min-h-screen flex items-center justify-center bg-gray-100 py-12"> <!-- Espace vertical ajouté -->
        <div class="bg-white p-8 rounded-lg shadow-md w-full max-w-lg">
            <h1 class="text-2xl font-bold text-gray-800 mb-6 text-center">Modification du profil de l'utilisateur {{ utilisateur.login }}</h1>

            {{ form_errors(modificationForm) }}

            {{ form_start(modificationForm) }}

            <div class="space-y-4">
                {{ form_row(modificationForm.email, {
                    attr: { class: 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500' }
                }) }}

                {{ form_row(modificationForm.password, {
                    label: 'Password',
                    attr: { class: 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500' }
                }) }}

                {{ form_row(modificationForm.numTelephone, {
                    attr: { class: 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500' }
                }) }}

                {{ form_row(modificationForm.visible, {
                    attr: {
                        class: 'w-5 h-5 text-green-600 bg-gray-100 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 dark:focus:ring-green-600 dark:bg-gray-700 dark:border-gray-600 ml-2 mt-1',
                    }
                }) }}

                {{ form_row(modificationForm.code, {
                    attr: { class: 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500' }
                }) }}
            </div>

            <div class="mt-6 flex justify-center">
                <button type="submit" class="w-full bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded-lg focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                    Modifier le profil
                </button>
            </div>

            {{ form_end(modificationForm) }}
        </div>
    </div>
{% endblock %}
