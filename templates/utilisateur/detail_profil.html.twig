{% extends 'base.html.twig' %}

{% block title %}Profil de {{ utilisateur.login }}{% endblock %}

{% block body %}
    <main class="flex items-center justify-center">
        <div class="bg-white p-8 border border-gray-200 rounded-lg shadow-lg w-full max-w-sm mt-8">
            <div class="flex flex-col items-center pb-10">
                <img class="w-24 h-24 mb-3 rounded-full shadow-lg" alt="user photo"
                        {% set photo = utilisateur.nomPhotoProfil %}
                        {% if photo is null %}
                            src="{{ asset('img/utilisateurs/anonyme.jpg') }}"
                        {% else %}
                            src="{{ asset('img/utilisateurs/uploads/' ~ photo) }}"
                        {% endif %}
                >
                <h5 class="mb-1 text-2xl font-bold text-gray-900 dark:text-white">{{ utilisateur.login }}</h5>
                <span class="block text-sm text-gray-500 dark:text-gray-400">@{{ utilisateur.login }}</span>

                <div class="text-left w-full mt-4 space-y-3">
                    <div class="flex items-center text-gray-600">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.389 4.448a4 4 0 004.222 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                        </svg>
                        <span> {{ utilisateur.email }}</span>
                    </div>

                    {% if utilisateur.numTelephone %}
                        <div class="flex items-center text-gray-600">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10l1-2a1 1 0 011.1-.6l2 .4a1 1 0 01.8.9l.3 2.3a1 1 0 01-.3.9l-.9.9a16.1 16.1 0 006.4 6.4l.9-.9a1 1 0 01.9-.3l2.3.3a1 1 0 01.9.8l.4 2a1 1 0 01-.6 1.1l-2 1a2 2 0 01-2.2-.1A19.7 19.7 0 013 12.2a2 2 0 01.1-2.2z"/>
                            </svg>
                            <span> {{ utilisateur.numTelephone }}</span>
                        </div>
                    {% endif %}

                    <div class="flex items-center text-gray-600">
                        <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" class="h-5 w-5 mr-2 text-purple-600" viewBox="0 0 16 16">
                            <path fill="currentColor" fill-rule="evenodd" d="M15.53 1.53A.75.75 0 0 0 14.47.47l-1.29 1.29a4.24 4.24 0 0 0-5.423.483l-.58.58a.96.96 0 0 0 0 1.354l4.646 4.646a.96.96 0 0 0 1.354 0l.58-.58a4.24 4.24 0 0 0 .484-5.423zm-8.5 4.94a.75.75 0 0 1 0 1.06L5.78 8.78l1.44 1.44l1.25-1.25a.75.75 0 0 1 1.06 1.06l-1.25 1.25l.543.543a.96.96 0 0 1 0 1.354l-.58.58a4.24 4.24 0 0 1-5.423.484l-1.29 1.29A.75.75 0 0 1 .47 14.47l1.29-1.29a4.24 4.24 0 0 1 .483-5.423l.58-.58a.96.96 0 0 1 1.354 0l.543.543l1.25-1.25a.75.75 0 0 1 1.06 0M3.5 8.62l-.197.197a2.743 2.743 0 0 0 3.879 3.879l.197-.197zm9.197-1.439l-.197.197L8.621 3.5l.197-.197a2.743 2.743 0 0 1 3.879 3.879" clip-rule="evenodd"/>
                        </svg>
                        <span> {{ utilisateur.connectedAt | date('d/m H:i') }}</span>
                    </div>

                    {% if utilisateur.updatedAt %}
                        <div class="flex items-center text-gray-600">
                            <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" class="h-5 w-5 mr-2 text-red-500" viewBox="0 0 16 16">
                                <path fill="currentColor" d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5L13.5 4.793L14.793 3.5L12.5 1.207zm1.586 3L10.5 3.207L4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175l-.106.106l-1.528 3.821l3.821-1.528l.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325"/>
                            </svg>
                            <span>{{ utilisateur.updatedAt | date('d/m H:i') }}</span>
                        </div>
                    {% endif %}
                </div>
            </div>

            <div class="flex justify-center mt-6">
                <a href="{{ path('app_home') }}" class="inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-gradient-to-r from-blue-500 to-indigo-600 rounded-lg hover:from-blue-600 hover:to-indigo-700 focus:ring-4 focus:outline-none focus:ring-blue-300">
                    Accueil
                </a>
            </div>
        </div>
    </main>
{% endblock %}
