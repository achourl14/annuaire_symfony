{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}


{% block body %}
    <script defer src="{{ asset('js/Form/Utilisateur/Register/verif_form_register.js') }}"></script>
    <div class="min-h-screen justify-center py-12 sm:px-6 lg:px-8 px-6 pt-0 overflow-hidden">
        <div class="sm:mx-auto sm:w-full sm:max-w-md">
            <img class="mx-auto h-10 w-auto" src="{{ asset('img/login.svg') }}" alt="Register icon">
            <h2 class="mt-6 text-center text-3xl leading-9 font-extrabold text-gray-900">
                Créer un nouveau compte
            </h2>
            <p class="mt-2 text-center text-sm leading-5 text-blue-500 max-w">
                Ou
                <a href="{{ path('app_login') }}"
                   class="font-medium text-blue-500 hover:text-blue-500 focus:outline-none focus:underline transition ease-in-out duration-150">
                    se connecter à un compte existant
                </a>
            </p>
        </div>

        <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
            <div class="bg-white py-8 px-4 shadow sm:rounded-lg sm:px-10">
                {{ form_start(registrationForm) }}

                <div class="mt-4">
                    <label for="registration_login" class="block text-sm font-medium leading-5 text-gray-700">Login</label>
                    <div class="mt-1 rounded-md shadow-sm" id="form-login">
                        {{ form_widget(registrationForm.login, {
                            'attr': {
                                'class': 'form-control appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md placeholder-gray-400 focus:outline-none focus:shadow-outline-blue focus:border-blue-300 transition duration-150 ease-in-out sm:text-sm sm:leading-5'
                            }
                        }) }}
                    </div>
                </div>

                <div class="mt-4">
                    <label for="registration_email" class="block text-sm font-medium leading-5 text-gray-700">Email</label>
                    <div class="mt-1 rounded-md shadow-sm" id="form-email">
                        {{ form_widget(registrationForm.email, {
                            'attr': {
                                'class': 'form-control appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md placeholder-gray-400 focus:outline-none focus:shadow-outline-blue focus:border-blue-300 transition duration-150 ease-in-out sm:text-sm sm:leading-5'
                            }
                        }) }}
                    </div>
                </div>

                <div class="mt-4">
                    <label for="registration_visible" class="block text-sm font-medium leading-5 text-gray-700">Visibilité</label>
                    <div class="mt-1 rounded-md shadow-sm">
                        {{ form_widget(registrationForm.visible, {
                            'attr': {
                                'class': 'form-control appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md placeholder-gray-400 focus:outline-none focus:shadow-outline-blue focus:border-blue-300 transition duration-150 ease-in-out sm:text-sm sm:leading-5'
                            }
                        }) }}
                    </div>
                </div>

                <div class="mt-4">
                    <label for="registration_password" class="block text-sm font-medium leading-5 text-gray-700">Mot de passe</label>
                    <div class="mt-1 rounded-md shadow-sm" id="form-password">
                        {{ form_widget(registrationForm.plainPassword, {
                            'attr': {
                                'class': 'form-control appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md placeholder-gray-400 focus:outline-none focus:shadow-outline-blue focus:border-blue-300 transition duration-150 ease-in-out sm:text-sm sm:leading-5'
                            }
                        }) }}
                    </div>
                </div>

                <div class="mt-4">
                    <label for="registration_profile" class="block text-sm font-medium leading-5 text-gray-700">Profil</label>
                    <div class="mt-1 rounded-md shadow-sm">
                        {{ form_widget(registrationForm.profile, {
                            'attr': {
                                'class': 'form-control appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md placeholder-gray-400 focus:outline-none focus:shadow-outline-blue focus:border-blue-300 transition duration-150 ease-in-out sm:text-sm sm:leading-5'
                            }
                        }) }}
                    </div>
                </div>

                <div class="mt-4">
                    <label for="registration_code" class="block text-sm font-medium leading-5 text-gray-700">Code</label>
                    <div class="mt-1 rounded-md shadow-sm" id="form-code">
                        {{ form_widget(registrationForm.code, {
                            'attr': {
                                'class': 'form-control appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md placeholder-gray-400 focus:outline-none focus:shadow-outline-blue focus:border-blue-300 transition duration-150 ease-in-out sm:text-sm sm:leading-5'
                            }
                        }) }}
                    </div>
                </div>

                <div class="mt-4">
                    <label for="registration_agreeTerms" class="block text-sm font-medium leading-5 text-gray-700">Conditions d'utilisation</label>
                    <div class="mt-1">
                        {{ form_widget(registrationForm.agreeTerms, {
                            'attr': {
                                'class': 'form-checkbox h-4 w-4 text-indigo-600 transition duration-150 ease-in-out'
                            }
                        }) }}
                        <span class="ml-2 text-sm leading-5 text-gray-900">J'accepte les conditions d'utilisation</span>
                    </div>
                </div>

                <div class="mt-6">
                    <span class="block w-full rounded-md shadow-sm">
                        <button type="submit" id="submit-button" class="w-full flex justify-center py-2 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-blue-500 hover:bg-blue-500 focus:outline-none focus:border-indigo-700 focus:shadow-outline-indigo active:bg-indigo-700 transition duration-150 ease-in-out">
                            S'inscrire
                        </button>
                    </span>
                </div>

                {{ form_end(registrationForm) }}
            </div>
        </div>
    </div>
{% endblock %}
