<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Annuaire{% endblock %}</title>
        <link rel="shortcut icon" type="image/x-icon" href="{{ asset('img/logo_annuaire.png') }}" />
        <script src='https://flowbite.com/docs/flowbite.min.js'></script>
        <script defer src="{{ asset('js/Form/Utilisateur/Register/verif_code_user.js') }}"></script>
        <script defer src="{{ asset('js/Form/Utilisateur/Register/verif_email_user.js') }}"></script>
        <script defer src="{{ asset('js/Form/Utilisateur/Register/verif_login_user.js') }}"></script>
        <script defer src="{{ asset('js/Form/Utilisateur/makeUserVisibleInvisible.js') }}"></script>
        <script defer src="{{ asset('bundles/fosjsrouting/js/router.min.js') }}"></script>
        <script defer src="{{ path('fos_js_routing_js', { callback: 'fos.Router.setData' }) }}"></script>
        <script defer src="{{ asset('js/removeMessageFlash.js') }}"></script>
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}

            {% block importmap %}{{ importmap('app') }}{% endblock %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}

        {% block customImports %}{% endblock %}
    </head>
    <body>
        {% block header %}
            {{ include('Components/navbar.html.twig') }}
        {% endblock %}

    <div id="flashes-container" class="flex justify-center w-full p-4">
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                {{ component('MessageFlash', {message:  message, type: type}) }}
            {% endfor %}
        {% endfor %}
    </div>

{% block body %}{% endblock %}
</body>
</html>
