{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <div class="min-h-screen flex-col justify-center py-12 sm:px-6 lg:px-8 px-6 pt-0 overflow-hidden">
        <div class="sm:mx-auto sm:w-full sm:max-w-md">
            <img class="mx-auto h-10 w-auto" src="{{ asset('img/login.svg') }}" alt="Login icon">
            <h2 class="mt-6 text-center text-3xl leading-9 font-extrabold text-gray-900">
                Se connecter
            </h2>
            <p class="mt-2 text-center text-sm leading-5 text-blue-500 max-w">
                Ou
                <a href="{{ path('app_register') }}"
                   class="font-medium text-blue-500 hover:text-blue-500 focus:outline-none focus:underline transition ease-in-out duration-150">
                    créer un nouveau compte
                </a>
            </p>
        </div>


        <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
            <div class="bg-white py-8 px-4 shadow sm:rounded-lg sm:px-10">
                <form method="post">
{#                    {% if error %}#}
{#                        <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>#}
{#                    {% endif %}#}

                    {% if app.user %}
                        <div class="mb-3">
                            You are logged in as {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}">Logout</a>
                        </div>
                    {% endif %}
                    <div>
                        <label for="inputLogin" class="block text-sm font-medium leading-5  text-gray-700">Login</label>
                        <div class="mt-1 relative rounded-md shadow-sm">
                            <input type="text" value="{{ last_username }}" name="login" id="inputLogin"
                                   class="form-control appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md placeholder-gray-400 focus:outline-none focus:shadow-outline-blue focus:border-blue-300 transition duration-150 ease-in-out sm:text-sm sm:leading-5"
                                   autocomplete="username" required autofocus>
                            <div class="hidden absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                                <svg class="h-5 w-5 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd"
                                          d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z"
                                          clip-rule="evenodd"></path>
                                </svg>
                            </div>
                        </div>
                    </div>

                    <div class="mt-6">
                        <label for="inputPassword" class="block text-sm font-medium leading-5 text-gray-700">Mot de
                            passe</label>
                        <div class="mt-1 rounded-md shadow-sm">
                            <input type="password" name="password" id="inputPassword"
                                   class="form-control appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md placeholder-gray-400 focus:outline-none focus:shadow-outline-blue focus:border-blue-300 transition duration-150 ease-in-out sm:text-sm sm:leading-5"
                                   autocomplete="current-password" required>
                        </div>
                    </div>

                    <div class="mt-6 flex items-center justify-between">
                        {# Case rester connecté (cachée) #}
                        <div class="hidden flex items-center">
                            <input id="remember_me" name="remember" type="checkbox" value="1"
                                   class="form-checkbox h-4 w-4 text-indigo-600 transition duration-150 ease-in-out">
                            <label for="remember_me" class="ml-2 block text-sm leading-5 text-gray-900">Rester
                                connecté</label>
                        </div>

                        {# Lien mot de passe oublié (caché) #}
                        <div class="hidden text-sm leading-5">
                            <a href="#"
                               class="font-medium text-blue-500 hover:text-blue-500 focus:outline-none focus:underline transition ease-in-out duration-150">
                                Mot de passe oublié
                            </a>
                        </div>
                    </div>

                    <input type="hidden" name="_csrf_token"
                           value="{{ csrf_token('authenticate') }}"
                    >

                    <div class="mt-6">
                        <span class="block w-full rounded-md shadow-sm">
                            <button type="submit"
                                class="w-full flex justify-center py-2 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-blue-500 hover:bg-blue-500 focus:outline-none focus:border-indigo-700 focus:shadow-outline-indigo active:bg-indigo-700 transition duration-150 ease-in-out">
                            Se connecter
                            </button>
                        </span>
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
